{
  "name": "arcturian-babylon-asset-qa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types tests/asset-review.mjs && node tests/gltf-geometry.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && vite build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@babylonjs/core": "9.37.0",
    "@babylonjs/loaders": "9.37.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "@playwright/test": "1.56.1",
    "pngjs": "7.0.0"
  }
}
