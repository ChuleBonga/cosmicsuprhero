{
  "name": "arcturian-awakening-phaser-preview",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/materialize-media.mjs && vite --host 0.0.0.0",
    "build": "node scripts/materialize-media.mjs && tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run build",
    "verify:media": "node scripts/materialize-media.mjs && node scripts/verify-audio.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
