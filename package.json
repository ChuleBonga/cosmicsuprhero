{
  "name": "cosmicsuprhero-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm install --prefix game-walk --no-audit --no-fund && npm run build --prefix game-walk && node scripts/embed-game.mjs",
    "preview": "vite preview",
    "validate:assets": "node scripts/validate-public-assets.mjs",
    "check": "npm run build",
    "remotion:studio": "remotion studio src/remotion/index.ts",
    "remotion:render:observatory": "remotion render src/remotion/index.ts observatory-intro renders/observatory-intro.mp4",
    "remotion:render:soil": "remotion render src/remotion/index.ts chamber-soil-and-sun renders/chamber-soil-and-sun.mp4",
    "remotion:render:all": "node scripts/render-remotion-compositions.mjs",
    "build:site": "vite build"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.475",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "remotion": "^4.0.475",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
