{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/main.ts",
    "src/audio/**/*.ts",
    "src/progress/**/*.ts"
  ],
  "exclude": [
    "src/scenes/**"
  ]
}